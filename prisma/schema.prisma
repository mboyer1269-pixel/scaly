// ============================================================================
// Scaly — schéma Postgres actif via Prisma.
// STORE_PROVIDER=prisma utilise ce schéma avec Neon/Postgres; STORE_PROVIDER
// absent ou "memory" garde la démo locale éphémère. Choix assumé :
// transcript/intelligence en Json au départ (vitesse P1), extraction en
// colonnes/tables dédiées quand les requêtes analytiques l'exigeront (P3+).
// Voir docs/DECISIONS.md (ADR-007).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id              String   @id
  name            String
  businessDescription String?
  reviewUrl       String?  // lien d'avis approuvé (source des demandes d'avis)
  industry        String
  sectorLabel     String
  ownerName       String
  ownerEmail      String
  mainPhone       String
  twilioPhoneNumber String? @unique
  transferPhone   String
  city            String
  languages       String[] // ["fr","en"]
  defaultLanguage String
  tone            String
  hours           Json     // { open, close, days[] }
  escalationRules Json
  essentialQuestions String[]
  services        String[]
  serviceAreas    String[]
  policies        String[]
  followUp        Json
  coverage        Json?
  compliance      Json
  planId          String
  billing         Json?    // CompanyBilling — écrit par le webhook Stripe uniquement
  createdAt       DateTime @default(now())

  agents   VoiceAgent[]
  calls    Call[]
  actions  Action[]
  audits   AuditLog[]
  usage    UsagePeriod[]
  consents Consent[]
  reviewItems ReviewItem[]
  readinessEvidence ReadinessEvidence[]
  businessKnowledge BusinessKnowledgeItem[]
  ownerNotifications OwnerNotification[]
  reviewRequests ReviewRequest[]
  waitlistEntries WaitlistEntry[]
  appointmentGaps AppointmentGap[]
  recoveryOffers RecoveryOffer[]
  runtimeEvents RuntimeEvent[]
}

// Coffre de consentements (ADR-018) — par personne, opposable, révocable.
model Consent {
  id           String    @id
  companyId    String
  phone        String // numéro canonique (chiffres, sans le 1 initial)
  kind         String // rappel | reactivation
  status       String // actif | refuse | revoque
  verbatim     String // réponse EXACTE de la personne — la preuve
  channel      String // appel | sms | manuel
  sourceCallId String?
  capturedAt   DateTime
  revokedAt    DateTime?
  revokedVia   String?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, phone])
}

model VoiceAgent {
  id                     String  @id
  companyId              String
  displayName            String
  persona                String
  style                  String
  languages              String[]
  greetingScript         String
  closingScript          String
  qualificationScriptId  String
  allowedPhrases         String[]
  forbiddenPhrases       String[]
  safetyRules            String[]
  answerLimits           String[]
  transferPolicy         String
  ownerInstructions      String[] @default([])
  voiceProfile           Json

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Call {
  id           String   @id
  companyId    String
  direction    String
  status       String
  source       String
  fromNumber   String
  callerName   String?
  language     String
  startedAt    DateTime
  durationSec  Int
  scriptId     String?
  personaId    String?
  seed         Int?
  transcript   Json     // TranscriptTurn[]
  intelligence Json?    // CallIntelligence
  recordingUrl String?
  provenance   Json?    // { provider?, externalId? (ex. callSid Twilio), verifiedAt? } — idempotence

  company Company  @relation(fields: [companyId], references: [id])
  actions Action[]

  @@index([companyId, startedAt])
  @@index([companyId, status])
}

model Action {
  id         String    @id
  companyId  String
  callId     String?
  type       String
  title      String
  payload    Json
  status     String
  attempts   Int       @default(0)
  lastError  String?
  executor   String
  executedAt DateTime?
  createdAt  DateTime  @default(now())
  audit      Json      // AuditEntry[]

  company Company @relation(fields: [companyId], references: [id])
  call    Call?   @relation(fields: [callId], references: [id])

  @@index([companyId, status])
  @@index([callId])
}

// Session du Voice Runtime Lab (P2A). Rétention Loi 25 : `turns` et `events`
// contiennent du verbatim → purgés après retentionDays (mêmes règles que
// Call.transcript). `fields` et `telemetry` sont agrégés → conservés.
model VoiceSession {
  id         String    @id
  companyId  String
  scenarioId String?
  status     String
  language   String
  startedAt  DateTime
  endedAt    DateTime?
  turns      Json // VoiceTurn[] — verbatim, purgeable
  events     Json // VoiceRuntimeEvent[] — verbatim, purgeable
  fields     Json // VoiceFieldState[] — agrégé, conservé
  telemetry  Json // VoiceRuntimeTelemetry — agrégé, conservé
  callId     String?

  @@index([companyId, startedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  actor     String
  event     String
  detail    String?
  at        DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId, at])
}

model UsagePeriod {
  id          String @id @default(cuid())
  companyId   String
  periodLabel String // "2026-06"
  minutesUsed Int
  callsCount  Int

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, periodLabel])
}

model ReviewItem {
  id         String   @id
  companyId  String
  callId     String
  reason     String
  evidence   String
  status     String
  resolution String?
  createdAt  DateTime
  resolvedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status, createdAt])
  @@index([callId])
}

model ReadinessEvidence {
  id         String   @id
  companyId  String
  kind       String
  status     String
  label      String
  detail     String
  callId     String?
  externalId String?
  verifiedAt DateTime?
  createdAt  DateTime

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, kind, createdAt])
  @@index([callId])
}

// Business Brain (PR #24) — connaissances owner. Seuls les items owner_manual
// sont persistés ; les items company_config sont dérivés à la lecture.
model BusinessKnowledgeItem {
  id          String   @id
  companyId   String
  title       String
  content     String
  sourceLabel String
  sourceType  String   // company_config | owner_manual | website | onboarding
  status      String   // draft | approved | archived
  createdAt   DateTime
  approvedAt  DateTime?
  expiresAt   DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
}

// Notification propriétaire (PR #25/#26) — alertes owner-facing durables.
model OwnerNotification {
  id                   String   @id
  companyId            String
  type                 String   // post_call_summary | unknown_answer | escalation | follow_up_needed
  status               String   // pending | sent | failed | dismissed
  title                String
  summary              String
  recommendedAction    String
  urgency              String   // critique | haute | normale | basse
  sourceCallId         String?
  sourceTraceId        String?
  modelCostEstimateCad Float?
  createdAt            DateTime
  updatedAt            DateTime
  sentAt               DateTime?
  dismissedAt          DateTime?
  deliveryClaimedAt    DateTime?
  providerMessageId    String?
  failureReason        String?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
}

// ============================================================================
// Remplissage intelligent des annulations (capability appointment_gap_recovery).
// Trois objets GÉNÉRIQUES — le contexte métier vit dans les Industry Packs.
// ============================================================================

// « Appelez-moi si une place se libère » — capté en appel, consentement connu.
model WaitlistEntry {
  id                     String   @id
  companyId              String
  industryPackId         String?
  capabilityId           String   // appointment_gap_recovery
  callerName             String?
  phone                  String
  sourceCallId           String?
  desiredServiceCategory String?
  desiredServiceLabel    String?
  preferredTimeWindow    String?
  urgency                String?  // critique | haute | normale | basse
  channelPreference      String   // sms | call | unknown
  consentToSms           String   // yes | no | unknown
  status                 String   // active | contacted | confirmed | cancelled | expired
  notes                  String?
  createdAt              DateTime
  updatedAt              DateTime
  cancelledAt            DateTime?
  cancelReason           String?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
}

// Une plage libérée — sans calendrier complet, le libellé humain fait foi.
model AppointmentGap {
  id              String   @id
  companyId       String
  industryPackId  String?
  capabilityId    String   // appointment_gap_recovery
  serviceCategory String?
  serviceLabel    String?
  startsAt        DateTime?
  endsAt          DateTime?
  humanLabel      String
  source          String   // manual | system | call
  status          String   // open | offered | filled | cancelled | expired
  idempotencyKey  String?
  createdAt       DateTime
  updatedAt       DateTime
  cancelledAt     DateTime?
  cancelReason    String?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, idempotencyKey])
  @@index([companyId, status])
}

// La relance prudente qui relie plage et candidat — idempotente par (gap, entrée).
model RecoveryOffer {
  id              String   @id
  companyId       String
  gapId           String
  waitlistEntryId String
  channel         String   // sms | call | action_only
  status          String   // prepared | sent | confirmed | declined | cancelled | expired | failed
  messagePreview  String
  deliveryId      String?
  idempotencyKey  String
  createdAt       DateTime
  updatedAt       DateTime
  sentAt          DateTime?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, idempotencyKey])
  @@index([companyId, status])
  @@index([companyId, gapId])
}

// Event Outbox de la frontière Scaly (ADR-020) — chaque moment métier devient
// un événement JSON-safe, sans secret ni transcript, prêt pour Oria Action
// Ledger. Idempotence par (companyId, dedupeKey) ; dates écrites par le domaine.
model RuntimeEvent {
  id            String   @id
  companyId     String
  type          String   // call.session_started | call.transferred | call.completed | consent.captured | sms.opt_out_received | opportunity.detected | recovery.gap_opened | recovery.offer_sent | recovery.offer_confirmed | owner.notification_sent | runtime.failure | runtime.realtime_unavailable
  occurredAt    DateTime
  correlationId String   // callSid Twilio (voix) ou sms:<phone canonique> (SMS)
  externalId    String?
  dedupeKey     String
  schemaVersion Int
  payload       Json     // JSON-safe, caviardé (jamais de secret ni transcript)
  status        String   // pending | delivered | failed
  attempts      Int
  lastError     String?
  createdAt     DateTime
  updatedAt     DateTime

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, dedupeKey])
  @@index([companyId, status])
  @@index([companyId, correlationId])
}

// Demande d'avis (PR #27) — preuve sociale mesurable, permission-aware.
model ReviewRequest {
  id            String   @id
  companyId     String
  status        String   // eligible | drafted | sent | skipped | failed
  customerName  String?
  customerPhone String?
  sourceCallId  String?
  reason        String
  message       String
  reviewUrl     String?
  createdAt     DateTime
  updatedAt     DateTime
  sentAt        DateTime?
  skippedAt     DateTime?
  failureReason String?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
}
