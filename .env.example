# === Scaly � variables d'environnement ===
# EXEMPLE PUBLIC SEULEMENT.
# Ne jamais mettre de vraies cl�s API ici.

# LLM / OpenAI (moteur d'analyse Call Intelligence)
OPENAI_API_KEY=
# Modèle utilisé par LlmIntelligenceEngine (défaut : gpt-4o-mini)
SCALY_LLM_MODEL=

# Auth Clerk (P1). Les DEUX clés présentes => auth active, sinon app ouverte (dev).
# RBAC : publicMetadata.role = founder|owner|staff, exposé dans le session token
# (Dashboard -> Sessions -> Customize session token -> { "metadata": "{{user.public_metadata}}" })
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Secret du cron de purge Loi 25 (POST /api/cron/purge, en-tête Authorization: Bearer <secret>)
CRON_SECRET=

# ElevenLabs
ELEVENLABS_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Postgres / Prisma
DATABASE_URL=
# memory = démo in-memory | prisma = Postgres réel (exige DATABASE_URL migrée + seedée)
STORE_PROVIDER=memory
