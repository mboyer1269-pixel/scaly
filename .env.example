# === Scaly � variables d'environnement ===
# EXEMPLE PUBLIC SEULEMENT.
# Ne jamais mettre de vraies cl�s API ici.

# LLM / OpenAI (moteur d'analyse Call Intelligence)
OPENAI_API_KEY=
# Modèle utilisé par LlmIntelligenceEngine (défaut : gpt-4o-mini)
SCALY_LLM_MODEL=

# Auth Clerk (P1). Les DEUX clés présentes => auth active, sinon app ouverte (dev).
# RBAC : publicMetadata.role = founder|owner|staff, exposé dans le session token
# (Dashboard -> Sessions -> Customize session token -> { "metadata": "{{user.public_metadata}}" })
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Secret du cron de purge Loi 25 (POST /api/cron/purge, en-tête Authorization: Bearer <secret>)
CRON_SECRET=

# ElevenLabs
ELEVENLABS_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# === P2B — voix réelle (voir docs/VOICE.md, runbook) ===
# URL publique de l'app (ngrok/Vercel). Sert à valider la signature Twilio.
# Si absente, l'URL est reconstruite depuis les en-têtes x-forwarded-*.
SCALY_PUBLIC_URL=
# WebSocket public du pont scaly-realtime (ex. wss://<ngrok-realtime>/twilio).
# Si absente, le webhook sert le repli <Dial> : l'humain prend l'appel.
SCALY_REALTIME_WS_URL=
# Côté pont (npm run realtime) :
REALTIME_PORT=8081
SCALY_APP_URL=http://localhost:3000
# Secret partagé pont <-> app (en-tête x-scaly-secret sur /api/voice/context et /complete)
REALTIME_SHARED_SECRET=
OPENAI_REALTIME_MODEL=gpt-realtime
SCALY_REALTIME_VOICE=marin

# Postgres / Prisma
DATABASE_URL=
# memory = démo in-memory | prisma = Postgres réel (exige DATABASE_URL migrée + seedée)
STORE_PROVIDER=memory
